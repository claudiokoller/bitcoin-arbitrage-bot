                {"iban": "XXXXXXXXXXXX", "bic": "XXXXXXXXXXX", "beneficiary": "Your Name", "name": "Bank A", "instant": true},
                {"iban": "XXXXXXXXXXXX", "bic": "XXXXXXXXXXX", "beneficiary": "Your Name", "name": "Bank B", "instant": false, "instant_fallback": "Bank A"}
